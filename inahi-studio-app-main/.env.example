SECRET_KEY=
ADMIN_PASSWORD_HASH=
PUBLIC_BASE_URL=http://127.0.0.1:5000
DATABASE_PATH=consultas.db
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESENCIAL=
STRIPE_PRICE_CRECIMIENTO=
STRIPE_PRICE_PRO=

# Copilot is enabled only after an explicit, reported local migration (--copilot).
# Local rules make no external calls. Never place real credentials in this file.
COPILOT_PROVIDER=local
COPILOT_MODEL=
COPILOT_API_KEY=
COPILOT_ALLOW_EXTERNAL=false
COPILOT_MAX_OUTPUT_TOKENS=1200
COPILOT_REQUESTS_PER_MINUTE=5
COPILOT_MAX_INFLIGHT=2
# Defaults inherit the B2B plan's AI allowance. Optional overrides:
# COPILOT_LIMIT_STARTER=100
# COPILOT_LIMIT_PROFESSIONAL=1000
# COPILOT_LIMIT_BUSINESS=10000
# COPILOT_LIMIT_ENTERPRISE=unlimited
# Optional USD estimates; use current prices for the configured provider/model.
# COPILOT_INPUT_USD_PER_MILLION=
# COPILOT_OUTPUT_USD_PER_MILLION=
