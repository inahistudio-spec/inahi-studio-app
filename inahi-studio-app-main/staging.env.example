# Reference only: inject into a clean process/secret manager; never commit actual values.
APP_ENV=staging
FLASK_SKIP_DOTENV=1
DATABASE_URL=
STAGING_DB_HOST=
STAGING_DB_NAME=inahi_staging_eval
STAGING_DB_USER=inahi_staging_runner
SECRET_KEY=
STAGING_DEMO_PASSWORD=
# Dedicated staging project key. Generic COPILOT_API_KEY and OPENAI_API_KEY must be absent.
STAGING_COPILOT_API_KEY=
COPILOT_PROVIDER=local
COPILOT_MODEL=
COPILOT_EXTERNAL_ENABLED=false
COPILOT_ALLOW_EXTERNAL=false
COPILOT_FALLBACK_LOCAL=true
COPILOT_TIMEOUT_SECONDS=30
COPILOT_MAX_OUTPUT_TOKENS=1200
COPILOT_REQUESTS_PER_MINUTE=30
COPILOT_MAX_INFLIGHT=2
# Set verified current rates for the exact configured provider/model before activation.
COPILOT_PRICE_PROVIDER=
COPILOT_PRICE_MODEL=
COPILOT_INPUT_USD_PER_MILLION=
COPILOT_OUTPUT_USD_PER_MILLION=
STRIPE_MODE=test
ALLOW_LIVE_PAYMENTS=false
PUBLIC_BASE_URL=http://127.0.0.1:5057
# Only for a server bound to loopback; false for remote HTTPS staging.
STAGING_LOCAL_HTTP=false
